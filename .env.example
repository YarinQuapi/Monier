# MySQL connection string used by Prisma (see prisma.config.ts)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Note on `sslaccept=accept_invalid_certs`: harmless to leave on for a
# plain mysql_native_password/caching_sha2_password server. It's required
# if your DB user authenticates via the `sha256_password` plugin, which
# needs an encrypted connection. Even with this, `prisma migrate`/`db
# execute`/`db seed` CANNOT connect through that plugin (Prisma's CLI
# engine doesn't support it) — see src/lib/db-url.ts and
# scripts/apply-migrations.mjs (run via `npm run db:apply-migrations`) for
# the app's own workaround, which the app's runtime code uses instead.
DATABASE_URL="mysql://root:password@localhost:3306/finance?sslaccept=accept_invalid_certs"

# NextAuth
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-random-secret"

# Bootstrap admin user, used by `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
