// Prisma schema for the Money Management System.
// Conventions: cuid() string IDs, createdAt/updatedAt on every model,
// explicit @relation on both sides, @@index on frequently queried FKs/dates.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // Connection URL is configured in prisma.config.ts (Prisma ORM 7+),
  // not here. See DATABASE_URL in .env.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  BANK_ACCOUNT
}

enum IncomeType {
  SALARY
  MISC
}

enum SubscriptionBillingType {
  ONGOING_MONTHLY
  ONGOING_ANNUAL
  FIXED_TERM
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  incomes           Income[]
  paymentMethods    PaymentMethod[]
  subscriptions     Subscription[]
  purchases         Purchase[]
  categoriesCreated Category[]      @relation("CategoryCreatedBy")
  apiTokens           ApiToken[]
  iosShortcutInstalls IosShortcutInstall[]

  @@index([role])
}

/// Global, admin-curated expense taxonomy shared by every user.
/// Created/updated/removed exclusively via the authenticated Admin Panel.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  icon        String?
  createdById String
  createdBy   User     @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]
  apiTokensDefaultingTo ApiToken[] @relation("ApiTokenDefaultCategory")

  @@index([createdById])
}

/// Manually logged income (salary or miscellaneous), per user.
model Income {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       IncomeType
  label      String
  amount     Decimal    @db.Decimal(12, 2)
  receivedAt DateTime
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([userId, receivedAt])
}

/// A credit card or bank account belonging to a user.
/// Credit-card billing-cycle fields are null for debit cards and bank
/// accounts (both settle immediately, with no statement/billing cycle).
model PaymentMethod {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PaymentMethodType
  nickname    String
  institution String?
  isActive    Boolean           @default(true)

  /// Day of month (1-31) the billing cycle starts, e.g. 10 -> cycle runs 10th-9th. Credit cards only.
  cycleStartDay  Int?
  /// Day of month (1-31) the statement payment is due. Credit cards only.
  paymentDueDay  Int?
  /// How many months after the cycle closes the payment is due (issuer-specific). Credit cards only.
  dueMonthOffset Int?     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  purchases     Purchase[]
  apiTokensDefaultingTo ApiToken[] @relation("ApiTokenDefaultPaymentMethod")

  @@index([userId])
  @@index([userId, type])
}

/// A recurring or fixed-term subscription, always tied to one payment method.
/// Multiple distinct accounts for the same provider are supported via accountLabel.
model Subscription {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerName      String
  accountLabel      String
  amount            Decimal                 @db.Decimal(12, 2)
  paymentMethodId   String
  paymentMethod     PaymentMethod           @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  billingType       SubscriptionBillingType
  /// Day of month the charge occurs. For ONGOING_ANNUAL, the charge recurs
  /// every 12 months in the same calendar month as startDate.
  billingDayOfMonth Int
  /// First charge date; supports deferred starts (e.g. starts 2 months from now).
  startDate         DateTime
  /// Required when billingType = FIXED_TERM (e.g. 6-month plan).
  totalMonths       Int?
  /// Optional explicit end date for ONGOING_MONTHLY/ONGOING_ANNUAL subscriptions.
  endDate           DateTime?
  isActive          Boolean                 @default(true)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([userId])
  @@index([paymentMethodId])
  @@index([userId, isActive])
}

/// A single one-off expense, tagged with a global category and
/// optionally linked to the payment method used.
model Purchase {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  amount          Decimal        @db.Decimal(12, 2)
  merchant        String?
  purchaseDate    DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([userId, purchaseDate])
  @@index([categoryId])
  @@index([paymentMethodId])
}

/// A personal access token for logging purchases from outside the web app
/// (e.g. an iOS Shortcut). The raw token is shown to the user exactly once
/// at creation time; only its SHA-256 hash is ever persisted. `tokenPrefix`
/// (the token's first 8 chars) is stored in the clear purely so the token
/// list UI can help the user tell tokens apart without re-exposing them.
/// `defaultCategory`/`defaultPaymentMethod` let a quick-log request omit
/// those fields entirely, since the whole point is a single-tap iOS
/// Shortcut that only prompts for an amount (and optional merchant/note).
model ApiToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String   @unique
  tokenPrefix String

  defaultCategoryId      String?
  defaultCategory        Category?      @relation("ApiTokenDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  defaultPaymentMethodId String?
  defaultPaymentMethod   PaymentMethod? @relation("ApiTokenDefaultPaymentMethod", fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  iosShortcutInstalls IosShortcutInstall[]

  @@index([userId])
  @@index([defaultCategoryId])
  @@index([defaultPaymentMethodId])
}

/// A signed iOS Shortcut file the user can install by scanning a QR code.
/// The file has the API token baked in, so the download URL is a secret
/// (anyone with the link can log purchases until the token is revoked).
model IosShortcutInstall {
  id         String    @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiTokenId String?
  apiToken   ApiToken?  @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  file       Bytes
  createdAt  DateTime   @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([apiTokenId])
  @@index([expiresAt])
}

/// Global key/value settings (admin-managed). Used for iOS Shortcut
/// quick-log response message templates and similar app-wide config.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
